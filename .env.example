# Names only. Do not put real values in this file.
# Spring Boot does not load .env by itself. Export these in the shell or set them on the IntelliJ run configuration.
# The test profile does not read any of these variables. The local profile only reads
# the DB_* variables below, and only to override their already-working defaults.
# The cloud profile refuses to start when DB_URL or BLOB_ENDPOINT is missing.

# JDBC URL for the cloud profile.
DB_URL=

# Object storage endpoint for the cloud profile.
BLOB_ENDPOINT=

# RH-182/RH-183: browser deployment. Prefer one HTTPS origin for the SPA and /api.
# Cloud defaults to no cross-origin access; local defaults to http://localhost:3000.
# Comma-separated exact origins. Wildcards, paths and credential-bearing URLs fail startup.
CORS_ALLOWED_ORIGINS=
# Cloud cookie policy: lax (default), strict, or none. All cloud cookies stay Secure.
# None requires Secure and a client/edge topology that can transport CSRF tokens correctly.
SESSION_COOKIE_SAME_SITE=
# Default none. Set native only behind a trusted, correctly configured TLS-terminating proxy.
FORWARD_HEADERS_STRATEGY=
# Frontend build only: local (default) or cloud. Cloud connections require HTTPS/WSS.
RESEARCHHUB_DEPLOYMENT_ENV=
# Optional exact additional connect-src origins, e.g. the configured collaboration WSS origin.
RESEARCHHUB_CSP_CONNECT_ORIGINS=

# Local PostgreSQL for docker compose and the local profile. Each already has a working
# default matching compose.yaml; only set one to override it, for example to avoid a port
# conflict. Unrelated to DB_URL above; the cloud profile does not read these.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Optional overrides for the local Azurite service. The defaults in compose.yaml and
# application-local.yaml work together without an .env file. If the port is changed here,
# set AZURITE_BLOB_ENDPOINT to the matching URL.
AZURITE_BLOB_PORT=
AZURITE_BLOB_ENDPOINT=
AZURITE_ACCOUNT_NAME=
AZURITE_ACCOUNT_KEY=
AZURITE_CONTAINER_NAME=

# Optional local durable-processing overrides. The defaults start the dispatcher and target
# the ai-worker service on localhost. When changing its published port, update the base URL too.
AI_WORKER_PORT=
AI_WORKER_BASE_URL=
AI_WORKER_REQUEST_TIMEOUT=
AI_WORKER_SOURCE_ACCESS_TTL=
# Required outside localhost. Spring and ai-worker must receive the same value (minimum 32 characters).
AI_WORKER_SERVICE_TOKEN=
PROCESSING_DISPATCHER_ENABLED=
PROCESSING_FIXED_DELAY=
PROCESSING_BATCH_SIZE=
PROCESSING_MAX_ATTEMPTS=
PROCESSING_INITIAL_BACKOFF=
PROCESSING_MAX_BACKOFF=
PROCESSING_STALE_TIMEOUT=

# Worker parser limits (defaults and ceilings in docs/development/source-extraction.md).
# Parser runs in a killable subprocess: wall <=25s, CPU <=20s, memory 128..1024 MiB.
AI_WORKER_PARSE_TIMEOUT_SECONDS=
AI_WORKER_PARSE_CPU_SECONDS=
AI_WORKER_PARSE_MEMORY_MIB=
AI_WORKER_MAX_FILE_BYTES=
AI_WORKER_MAX_CHARACTERS=
AI_WORKER_MAX_UNITS=
AI_WORKER_MAX_PAGES=
AI_WORKER_MAX_ZIP_BYTES=
AI_WORKER_MAX_SHEETS=
AI_WORKER_XLSX_ROWS=
AI_WORKER_XLSX_COLUMNS=
AI_WORKER_CHUNK_MAX_CHARACTERS=
AI_WORKER_CHUNK_OVERLAP_CHARACTERS=
AI_WORKER_CHUNK_MIN_CHARACTERS=
AI_WORKER_PREVIEW_ROWS=
AI_WORKER_XLSX_SAMPLES=
# Compose-only origin translation when Spring uses the host's Azurite endpoint.
# Preserve the exact signed URL path/query; native/cloud workers normally leave both unset.
AI_WORKER_BLOB_URL_ORIGIN=
AI_WORKER_BLOB_URL_TARGET_ORIGIN=

# Offline/test default. Select azure to use a deployed embedding model; every model
# setting below is required in that mode. Changing model/version/dimension requires reprocessing.
AI_WORKER_EMBEDDING_PROVIDER=deterministic
AZURE_EMBEDDING_ENDPOINT=
AZURE_EMBEDDING_API_KEY=
AZURE_EMBEDDING_DEPLOYMENT=
AZURE_EMBEDDING_MODEL=
AZURE_EMBEDDING_VERSION=
AZURE_EMBEDDING_DIMENSION=

# RH-110: independent generation provider; deterministic is an extractive test fixture.
AI_WORKER_MODEL_PROVIDER=deterministic
# Foundry Azure OpenAI HTTPS origin, e.g. https://RESOURCE.openai.azure.com (no path).
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_DEPLOYMENT=
# Exact model name returned by the deployment and an immutable deployment/model revision.
FOUNDRY_MODEL=
FOUNDRY_MODEL_VERSION=
# Spring feature settings. Use temperature "none" if unsupported by the deployment.
AI_GROUNDED_RESPONSE_TEMPERATURE=
AI_GROUNDED_RESPONSE_MAX_OUTPUT_TOKENS=
AI_GROUNDED_RESPONSE_CONTEXT_MAX_TOKENS=
AI_GROUNDED_RESPONSE_CONTEXT_MAX_BYTES=
AI_GROUNDED_RESPONSE_CONTEXT_COLLAPSE_EXACT_DUPLICATES=
AI_WORKSPACE_QUESTION_TOP_K=
AI_WORKSPACE_QUESTION_TEMPERATURE=
AI_WORKSPACE_QUESTION_MAX_OUTPUT_TOKENS=
AI_CONVERSATION_STREAM_MAX_CONCURRENT=
AI_CONVERSATION_STREAM_TIMEOUT=
AI_CONVERSATION_STREAM_HEARTBEAT=

# RH-120–122: authoring uses the same configured worker provider and bounded context builder.
AI_AUTHORING_MAX_OUTPUT_TOKENS=
AI_AUTHORING_TEMPERATURE=

# RH-144: opt-in local Docker execution. The image is always researchhub-sandbox:1.1.0.
# Use an absolute Unix socket path; Docker Desktop commonly uses /Users/<user>/.docker/run/docker.sock.
ANALYSIS_SANDBOX_ENABLED=
ANALYSIS_SANDBOX_SOCKET_PATH=
ANALYSIS_SANDBOX_TIMEOUT=
ANALYSIS_SANDBOX_MEMORY_MIB=
ANALYSIS_SANDBOX_CPUS=
ANALYSIS_SANDBOX_PIDS=
ANALYSIS_EXECUTION_DISPATCHER_ENABLED=
ANALYSIS_EXECUTION_FIXED_DELAY=

# RH-160–162: opt-in realtime authoring. Same random secret (>=32 characters) in Spring and Node.
# Activated documents stay CRDT-owned even if the flag is later disabled.
COLLABORATION_ENABLED=false
COLLABORATION_SERVICE_TOKEN=
COLLABORATION_WEBSOCKET_URL=ws://localhost:8091
COLLABORATION_TOKEN_TTL=PT120S
COLLABORATION_PORT=8091
COLLABORATION_BACKEND_URL=http://127.0.0.1:8080
COLLABORATION_ALLOWED_ORIGINS=http://localhost:3000
COLLABORATION_RECHECK_MS=5000
# Public build-time frontend flag; never put the private service token in frontend variables.
RESEARCHHUB_COLLABORATION_ENABLED=false
