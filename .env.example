# Names only. Do not put real values in this file.
# Spring Boot does not load .env by itself. Export these in the shell or set them on the IntelliJ run configuration.
# The local and test profiles do not read these variables.
# The cloud profile refuses to start when either value is missing.

# JDBC URL for the cloud profile.
DB_URL=

# Object storage endpoint for the cloud profile.
BLOB_ENDPOINT=
