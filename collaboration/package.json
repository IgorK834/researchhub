{
  "name": "researchhub-collaboration",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "vitest run --coverage",
    "test:browser": "npm run build && npm --prefix ../frontend run build:realtime && cd ../backend && COLLABORATION_BROWSER_TESTS=true ./mvnw -Dtest=CollaborationApiIntegrationTest test"
  },
  "dependencies": {
    "@hocuspocus/server": "3.4.3",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "lib0": "0.2.114",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.27"
  },
  "devDependencies": {
    "@hocuspocus/provider": "3.4.3",
    "@types/node": "22.15.30",
    "@vitest/coverage-v8": "3.2.7",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.7",
    "ws": "8.22.0"
  }
}
