{
  admin off
  auto_https off
}
:8080 {
  import /etc/caddy/security-headers.caddy
  handle /healthz {
    respond "OK" 200
  }
  handle /api/* {
    reverse_proxy {$API_UPSTREAM:backend:8080}
  }
  handle /actuator/* {
    reverse_proxy {$API_UPSTREAM:backend:8080}
  }
  handle {
    root * /srv
    @immutable path_regexp immutable \.[a-f0-9]{8,}\.(js|css|woff2?|svg|png)$
    header @immutable Cache-Control "public, max-age=31536000, immutable"
    header /index.html Cache-Control "no-cache"
    try_files {path} /index.html
    file_server
  }
}
