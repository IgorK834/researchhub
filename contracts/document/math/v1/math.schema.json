{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchhub.dev/contracts/document/math/v1/math.schema.json",
  "$defs": {
    "MathAst": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "value"
          ],
          "properties": {
            "op": {
              "const": "number"
            },
            "value": {
              "type": "string",
              "maxLength": 40,
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "name"
          ],
          "properties": {
            "op": {
              "const": "symbol"
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9]{0,15}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "const": "add"
            },
            "args": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/MathAst"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "const": "mul"
            },
            "args": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/MathAst"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ],
          "properties": {
            "op": {
              "const": "div"
            },
            "left": {
              "$ref": "#/$defs/MathAst"
            },
            "right": {
              "$ref": "#/$defs/MathAst"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ],
          "properties": {
            "op": {
              "const": "eq"
            },
            "left": {
              "$ref": "#/$defs/MathAst"
            },
            "right": {
              "$ref": "#/$defs/MathAst"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "base",
            "exponent"
          ],
          "properties": {
            "op": {
              "const": "pow"
            },
            "base": {
              "$ref": "#/$defs/MathAst"
            },
            "exponent": {
              "type": "integer",
              "minimum": -8,
              "maximum": 8
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "arg"
          ],
          "properties": {
            "op": {
              "const": "sqrt"
            },
            "arg": {
              "$ref": "#/$defs/MathAst"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "arg"
          ],
          "properties": {
            "op": {
              "const": "sin"
            },
            "arg": {
              "$ref": "#/$defs/MathAst"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "arg"
          ],
          "properties": {
            "op": {
              "const": "cos"
            },
            "arg": {
              "$ref": "#/$defs/MathAst"
            }
          }
        }
      ],
      "description": "Maximum 128 nodes and depth 12, enforced by all runtimes. Canonical decimals exclude negative zero and trailing fractional zeros."
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ast",
    "notation",
    "accessibleText",
    "verification"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "ast": {
      "$ref": "#/$defs/MathAst"
    },
    "notation": {
      "type": "string",
      "maxLength": 4000
    },
    "accessibleText": {
      "type": "string",
      "maxLength": 4000
    },
    "verification": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "analysisId",
            "executionId",
            "outputName",
            "stepIndex",
            "inputHash"
          ],
          "properties": {
            "analysisId": {
              "type": "string",
              "format": "uuid"
            },
            "executionId": {
              "type": "string",
              "format": "uuid"
            },
            "outputName": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9-]{0,79}$"
            },
            "stepIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 31
            },
            "inputHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    }
  }
}
