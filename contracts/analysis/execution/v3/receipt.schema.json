{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "phase",
    "status",
    "inputHash",
    "problemSha256",
    "planSha256",
    "candidateSha256",
    "tolerance",
    "checkedOutputs",
    "checkedPoints"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "phase": {
      "const": "VERIFY"
    },
    "status": {
      "const": "CHECKED"
    },
    "inputHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "problemSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "planSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidateSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "absolute",
        "relative"
      ],
      "properties": {
        "absolute": {
          "const": 1e-10
        },
        "relative": {
          "const": 1e-10
        }
      }
    },
    "checkedOutputs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "checkedPoints": {
      "type": "integer",
      "minimum": 0,
      "maximum": 201
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
