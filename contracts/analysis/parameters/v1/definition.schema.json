{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchhub.dev/contracts/analysis/parameters/v1/definition.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "type",
    "unit",
    "bounds",
    "defaultValue",
    "required"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]{0,15}$"
    },
    "type": {
      "const": "DECIMAL"
    },
    "unit": {
      "type": "string"
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum"
      ],
      "properties": {
        "minimum": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
          "not": {
            "const": "-0"
          }
        },
        "maximum": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
          "not": {
            "const": "-0"
          }
        }
      }
    },
    "defaultValue": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
      "not": {
        "const": "-0"
      }
    },
    "required": {
      "const": true
    }
  }
}
