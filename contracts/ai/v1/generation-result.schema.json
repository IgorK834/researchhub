{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidenceIds": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Evidenceids",
          "type": "array"
        }
      },
      "required": [
        "text",
        "evidenceIds"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ModelMetadata": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "structuredOutput": {
          "const": true,
          "default": true,
          "title": "Structuredoutput",
          "type": "boolean"
        },
        "streaming": {
          "const": false,
          "default": false,
          "title": "Streaming",
          "type": "boolean"
        }
      },
      "required": [
        "provider",
        "name",
        "version"
      ],
      "title": "ModelMetadata",
      "type": "object"
    },
    "StructuredAnswer": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "SUPPORTED",
            "INSUFFICIENT_EVIDENCE"
          ],
          "title": "Status",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "maxItems": 12,
          "title": "Claims",
          "type": "array"
        }
      },
      "required": [
        "status",
        "claims"
      ],
      "title": "StructuredAnswer",
      "type": "object"
    },
    "UsageMetadata": {
      "additionalProperties": false,
      "properties": {
        "inputTokens": {
          "maximum": 20000000,
          "minimum": 0,
          "title": "Inputtokens",
          "type": "integer"
        },
        "outputTokens": {
          "maximum": 20000000,
          "minimum": 0,
          "title": "Outputtokens",
          "type": "integer"
        },
        "totalTokens": {
          "maximum": 40000000,
          "minimum": 0,
          "title": "Totaltokens",
          "type": "integer"
        },
        "estimated": {
          "title": "Estimated",
          "type": "boolean"
        }
      },
      "required": [
        "inputTokens",
        "outputTokens",
        "totalTokens",
        "estimated"
      ],
      "title": "UsageMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "requestId": {
      "format": "uuid",
      "title": "Requestid",
      "type": "string"
    },
    "templateId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Templateid",
      "type": "string"
    },
    "templateHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Templatehash",
      "type": "string"
    },
    "model": {
      "$ref": "#/$defs/ModelMetadata"
    },
    "usage": {
      "$ref": "#/$defs/UsageMetadata"
    },
    "providerRequestId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Providerrequestid",
      "type": "string"
    },
    "answer": {
      "$ref": "#/$defs/StructuredAnswer"
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "templateId",
    "templateHash",
    "model",
    "usage",
    "providerRequestId",
    "answer"
  ],
  "title": "GenerationResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
