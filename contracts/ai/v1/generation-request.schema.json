{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "chunkId": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Chunkid",
          "type": "string"
        },
        "contentHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contenthash",
          "type": "string"
        },
        "content": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "chunkId",
        "contentHash",
        "content"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ModelParameters": {
      "additionalProperties": false,
      "properties": {
        "temperature": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "maxOutputTokens": {
          "maximum": 8192,
          "minimum": 16,
          "title": "Maxoutputtokens",
          "type": "integer"
        }
      },
      "required": [
        "maxOutputTokens"
      ],
      "title": "ModelParameters",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "requestId": {
      "format": "uuid",
      "title": "Requestid",
      "type": "string"
    },
    "templateId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Templateid",
      "type": "string"
    },
    "templateHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Templatehash",
      "type": "string"
    },
    "systemInstruction": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Systeminstruction",
      "type": "string"
    },
    "instruction": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Instruction",
      "type": "string"
    },
    "parameters": {
      "$ref": "#/$defs/ModelParameters"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 12,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "templateId",
    "templateHash",
    "systemInstruction",
    "instruction",
    "parameters",
    "evidence"
  ],
  "title": "GenerationRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
