{
  "$defs": {
    "BuiltContext": {
      "additionalProperties": false,
      "properties": {
        "summary": {
          "$ref": "#/$defs/ContextSummary"
        },
        "text": {
          "maxLength": 131072,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "summary",
        "text"
      ],
      "title": "BuiltContext",
      "type": "object"
    },
    "CitationBinding": {
      "additionalProperties": false,
      "properties": {
        "citationKey": {
          "pattern": "^S(?:[1-9]|1[0-2])$",
          "title": "Citationkey",
          "type": "string"
        },
        "chunkId": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Chunkid",
          "type": "string"
        },
        "textReference": {
          "anyOf": [
            {
              "pattern": "^S(?:[1-9]|1[0-2])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Textreference"
        }
      },
      "required": [
        "citationKey",
        "chunkId",
        "textReference"
      ],
      "title": "CitationBinding",
      "type": "object"
    },
    "ContextBudget": {
      "additionalProperties": false,
      "properties": {
        "maxTokens": {
          "maximum": 131072,
          "minimum": 64,
          "title": "Maxtokens",
          "type": "integer"
        },
        "maxBytes": {
          "maximum": 131072,
          "minimum": 64,
          "title": "Maxbytes",
          "type": "integer"
        },
        "collapseExactDuplicates": {
          "title": "Collapseexactduplicates",
          "type": "boolean"
        }
      },
      "required": [
        "maxTokens",
        "maxBytes",
        "collapseExactDuplicates"
      ],
      "title": "ContextBudget",
      "type": "object"
    },
    "ContextSummary": {
      "additionalProperties": false,
      "properties": {
        "builderVersion": {
          "const": "1.0",
          "title": "Builderversion",
          "type": "string"
        },
        "tokenPolicy": {
          "const": "utf8-conservative-v1",
          "title": "Tokenpolicy",
          "type": "string"
        },
        "budget": {
          "$ref": "#/$defs/ContextBudget"
        },
        "contextHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contexthash",
          "type": "string"
        },
        "contextBytes": {
          "minimum": 0,
          "title": "Contextbytes",
          "type": "integer"
        },
        "tokenUpperBound": {
          "minimum": 0,
          "title": "Tokenupperbound",
          "type": "integer"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/CitationBinding"
          },
          "maxItems": 12,
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "builderVersion",
        "tokenPolicy",
        "budget",
        "contextHash",
        "contextBytes",
        "tokenUpperBound",
        "citations"
      ],
      "title": "ContextSummary",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "chunkId": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Chunkid",
          "type": "string"
        },
        "contentHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contenthash",
          "type": "string"
        },
        "content": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "chunkId",
        "contentHash",
        "content"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "GenerationRequest": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "requestId": {
          "format": "uuid",
          "title": "Requestid",
          "type": "string"
        },
        "templateId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Templateid",
          "type": "string"
        },
        "templateHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Templatehash",
          "type": "string"
        },
        "systemInstruction": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Systeminstruction",
          "type": "string"
        },
        "instruction": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/ModelParameters"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 12,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "templateId",
        "templateHash",
        "systemInstruction",
        "instruction",
        "parameters",
        "evidence"
      ],
      "title": "GenerationRequest",
      "type": "object"
    },
    "ModelParameters": {
      "additionalProperties": false,
      "properties": {
        "temperature": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "maxOutputTokens": {
          "maximum": 8192,
          "minimum": 16,
          "title": "Maxoutputtokens",
          "type": "integer"
        }
      },
      "required": [
        "maxOutputTokens"
      ],
      "title": "ModelParameters",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "2.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/GenerationRequest"
    },
    "context": {
      "$ref": "#/$defs/BuiltContext"
    }
  },
  "required": [
    "schemaVersion",
    "request",
    "context"
  ],
  "title": "ContextualRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
