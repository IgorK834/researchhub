{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "researchhub:embeddings:batch:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "vectors"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "name",
        "version",
        "dimension"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "dimension": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    },
    "vectors": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4096,
        "items": {
          "type": "number"
        }
      }
    }
  },
  "$comment": "Applications additionally require vector count = text count; each vector has metadata.dimension finite components and a nonzero norm. HTTP requests batch at 32."
}
