{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "researchhub:embeddings:request:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "texts"
  ],
  "properties": {
    "texts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8000
      }
    }
  },
  "$comment": "Query operation requires exactly one text. Whitespace-only inputs are rejected. Request is bounded at 1 MiB."
}
