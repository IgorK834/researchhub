{
  "$defs": {
    "ChunkingConfig": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "hierarchical-char-1",
          "default": "hierarchical-char-1",
          "title": "Version",
          "type": "string"
        },
        "maxCharacters": {
          "default": 1600,
          "maximum": 8000,
          "minimum": 32,
          "title": "Maxcharacters",
          "type": "integer"
        },
        "overlapCharacters": {
          "default": 150,
          "minimum": 0,
          "title": "Overlapcharacters",
          "type": "integer"
        },
        "minCharacters": {
          "default": 200,
          "minimum": 1,
          "title": "Mincharacters",
          "type": "integer"
        }
      },
      "title": "ChunkingConfig",
      "type": "object"
    },
    "RetrievalChunk": {
      "additionalProperties": false,
      "properties": {
        "chunkId": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Chunkid",
          "type": "string"
        },
        "sourceId": {
          "format": "uuid",
          "title": "Sourceid",
          "type": "string"
        },
        "workspaceId": {
          "format": "uuid",
          "title": "Workspaceid",
          "type": "string"
        },
        "sourceVersionId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sourceversionid"
        },
        "chunkIndex": {
          "minimum": 0,
          "title": "Chunkindex",
          "type": "integer"
        },
        "content": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "pageStart": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pagestart"
        },
        "pageEnd": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pageend"
        },
        "sectionTitle": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sectiontitle"
        },
        "contentHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contenthash",
          "type": "string"
        },
        "processingVersion": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Processingversion",
          "type": "string"
        },
        "spans": {
          "items": {
            "$ref": "#/$defs/SourceSpan"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Spans",
          "type": "array"
        }
      },
      "required": [
        "chunkId",
        "sourceId",
        "workspaceId",
        "sourceVersionId",
        "chunkIndex",
        "content",
        "pageStart",
        "pageEnd",
        "sectionTitle",
        "contentHash",
        "processingVersion",
        "spans"
      ],
      "title": "RetrievalChunk",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "unitId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Unitid",
          "type": "string"
        },
        "characterStart": {
          "minimum": 0,
          "title": "Characterstart",
          "type": "integer"
        },
        "characterEnd": {
          "minimum": 1,
          "title": "Characterend",
          "type": "integer"
        }
      },
      "required": [
        "unitId",
        "characterStart",
        "characterEnd"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "sourceId": {
      "format": "uuid",
      "title": "Sourceid",
      "type": "string"
    },
    "workspaceId": {
      "format": "uuid",
      "title": "Workspaceid",
      "type": "string"
    },
    "sourceVersionId": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Sourceversionid"
    },
    "ingestionVersion": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Ingestionversion",
      "type": "string"
    },
    "parserVersion": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Parserversion",
      "type": "string"
    },
    "sourceContentHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sourcecontenthash",
      "type": "string"
    },
    "extractionContentHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Extractioncontenthash",
      "type": "string"
    },
    "processingVersion": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Processingversion",
      "type": "string"
    },
    "config": {
      "$ref": "#/$defs/ChunkingConfig"
    },
    "chunks": {
      "items": {
        "$ref": "#/$defs/RetrievalChunk"
      },
      "maxItems": 10000,
      "title": "Chunks",
      "type": "array"
    }
  },
  "required": [
    "sourceId",
    "workspaceId",
    "sourceVersionId",
    "ingestionVersion",
    "parserVersion",
    "sourceContentHash",
    "extractionContentHash",
    "processingVersion",
    "config",
    "chunks"
  ],
  "title": "RetrievalChunkSet",
  "type": "object"
}
