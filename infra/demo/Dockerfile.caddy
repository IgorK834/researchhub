FROM caddy:2.11.2-alpine@sha256:834468128c7696cec0ceea6172f7d692daf645ae51983ca76e39da54a97c570d
# The upstream binary requests NET_BIND_SERVICE; this image only uses port 8080.
# Remove the file capability so cap_drop=ALL works with an unprivileged process.
RUN setcap -r /usr/bin/caddy
RUN mkdir -p /data /config && chown -R 10001:10001 /data /config
USER 10001:10001
ENV XDG_CONFIG_HOME=/tmp/config XDG_DATA_HOME=/tmp/data
EXPOSE 8080
