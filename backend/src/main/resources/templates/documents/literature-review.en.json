{
  "id": "literature-review",
  "version": 1,
  "locale": "en",
  "title": "Literature review",
  "description": "Organize a transparent review without invented publications or findings.",
  "requiredPlaceholders": [
    {
      "id": "scope",
      "hint": "Define the question, population or topic, and review boundaries."
    },
    {
      "id": "search",
      "hint": "Record the databases, search terms and actual search dates."
    },
    {
      "id": "criteria",
      "hint": "Describe inclusion and exclusion criteria and the selection process."
    },
    {
      "id": "synthesis",
      "hint": "Compare the included publications; distinguish findings from your interpretation."
    },
    {
      "id": "gaps",
      "hint": "Describe uncertainty, conflicting findings and limits of the available evidence."
    },
    {
      "id": "conclusion",
      "hint": "Summarize what the verified literature supports and what remains unresolved."
    },
    {
      "id": "references",
      "hint": "Insert only publications you have verified; placeholders are not citations."
    }
  ],
