{
  "id": "statistical-report",
  "version": 1,
  "locale": "en",
  "title": "Statistical report",
  "description": "Describe data, assumptions and checked results without fabricated numbers.",
  "requiredPlaceholders": [
    {
      "id": "objective",
      "hint": "State the objective and distinguish confirmatory from exploratory analysis."
    },
    {
      "id": "data",
      "hint": "Describe the real dataset, variables, units, exclusions and missing values."
    },
    {
      "id": "method",
      "hint": "Specify the methods, software and decision rules actually used."
    },
    {
      "id": "assumptions",
      "hint": "Check the assumptions; do not claim that unperformed checks passed."
    },
    {
      "id": "results",
      "hint": "Insert checked analysis outputs explicitly; no estimates, p-values or effects are generated here."
    },
    {
      "id": "uncertainty",
      "hint": "Report uncertainty, practical meaning and limitations supported by the analysis."
    },
    {
      "id": "conclusion",
      "hint": "Separate numerical results from interpretation and avoid unsupported causal claims."
    },
    {
      "id": "references",
      "hint": "Record verified sources and data provenance using the existing citation and analysis tools."
    }
  ],
