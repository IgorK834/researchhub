      "hint": "Explain the purpose of this chapter and its role in your thesis."
    },
    {
      "id": "question",
      "hint": "State the question and define the key concepts."
    },
    {
      "id": "framework",
      "hint": "Develop a sourced framework; do not treat this outline as evidence."
    },
    {
      "id": "approach",
      "hint": "Explain the analytical approach or method actually used."
    },
    {
      "id": "argument",
      "hint": "Present your own argument supported by verified sources or observations."
    },
    {
      "id": "summary",
      "hint": "Summarize the supported conclusions and link to the next chapter."
    },
    {
      "id": "references",
      "hint": "Add verified citations; do not invent author, publication or date metadata."
    }
  ],
