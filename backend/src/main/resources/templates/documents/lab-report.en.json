{
  "id": "lab-report",
  "version": 1,
  "locale": "en",
  "title": "Laboratory report",
  "description": "A structure for your own measurements, methods and interpretation.",
  "requiredPlaceholders": [
    {
      "id": "aim",
      "hint": "State the objective and a testable question; do not invent a hypothesis."
    },
    {
      "id": "background",
      "hint": "Explain the relevant theory and add only verified source citations."
    },
    {
      "id": "methods",
      "hint": "Describe apparatus, procedure, units and measurement uncertainty."
    },
    {
      "id": "results",
      "hint": "Enter your actual measurements; leave unknown values empty."
    },
    {
      "id": "discussion",
      "hint": "Interpret only the observed results and describe limitations."
    },
    {
      "id": "conclusion",
      "hint": "Answer the research question using your own evidence."
    },
    {
      "id": "references",
      "hint": "Add verified citations using the editor; no references are supplied by this template."
    }
  ],
